{
  "_comment": "Telescope Handcontroller Replacement - Configuration",
  "mount": {
    "driver": "EQMOD",
    "port": "/dev/ttyUSB0",
    "model": "EQ3-2",
    "focal_length": 750,
    "aperture": 150,
    "focal_ratio": 5,
    "mount_type": "equatorial",
    "hemisphere": "northern",
    "slew_speed": 5,
    "tracking_mode": "stellar",
    "park_position_ra": 180,
    "park_position_dec": 90
  },
  "joystick": {
    "enabled": true,
    "device": "/dev/input/js0",
    "bindings": {
      "axis_ns": 1,
      "axis_ew": 0,
      "axis_deadzone": 8000,
      "btn_speed_up": 5,
      "btn_speed_down": 4,
      "btn_r1": 5,
      "btn_l1": 4,
      "btn_r2": 7,
      "btn_l2": 6,
      "btn_stop": 1,
      "btn_track_mode": 2,
      "btn_home": 0,
      "btn_exit": 3
    }
  },
  "guider_camera": {
    "driver": "ASI CCD",
    "model": "ASI120MC",
    "port": 1,
    "pixel_size": 3.75,
    "gain": 50,
    "offset": 10,
    "binning": 1,
    "temperature": 0
  },
  "imager_camera": {
    "driver": "ASI CCD",
    "model": "ASI715MC",
    "port": 2,
    "pixel_size": 2.9,
    "gain": 100,
    "offset": 20,
    "binning": 1,
    "temperature": 0
  },
  "plate_solving": {
    "method": "astap",
    "astap_binary": "/usr/bin/astap",
    "astap_star_db": "/opt/astap/star_db",
    "online_solver": "astrometry.net",
    "online_api_key": "",
    "online_url": "http://nova.astrometry.net/api/",
    "solve_timeout": 30,
    "max_ra_error_arcsec": 60,
    "max_dec_error_arcsec": 60,
    "search_radius_deg": 10,
    "use_guider": true
  },
  "alignment": {
    "stars_1": true,
    "stars_2": true,
    "stars_3": true,
    "plate_solve": true,
    "additive_correction": true,
    "max_align_points": 20,
    "use_cone_correction": true,
    "use_refraction_correction": true,
    "use_flexure_correction": false
  },
  "indi": {
    "server_host": "localhost",
    "server_port": 7624,
    "auto_start_server": true,
    "drivers": {
      "mount": "indi_eqmod_telescope",
      "camera": "indi_asi_ccd"
    }
  },
  "ui": {
    "touch_mode": true,
    "button_size": 80,
    "font_size": 14,
    "theme": "dark",
    "fullscreen": true,
    "language": "en",
    "show_grid": false,
    "status_refresh_ms": 500
  },
  "site": {
    "latitude": 48.8566,
    "longitude": 2.3522,
    "elevation": 75,
    "timezone": "Europe/Paris",
    "temperature_c": 15,
    "pressure_hpa": 1013
  },
  "catalogs": {
    "messier": true,
    "ngc": true,
    "ic": false,
    "bright_stars": true,
    "double_stars": false,
    "planets": true,
    "custom_objects": []
  }
}
